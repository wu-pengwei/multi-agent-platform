    {"turn": 12, "user": "部署通过 Docker 完成。", "expected_in": ["Docker"]},
    {"turn": 13, "user": "代码仓库的主分支叫 main。", "expected_in": ["main"]},
    {"turn": 14, "user": "发布流程需要先跑 lint。", "expected_in": ["lint"]},
    {"turn": 15, "user": "错误日志保留 30 天。", "expected_in": ["30 天"]},
    {"turn": 16, "user": "告警发送到 engineering@example.com。", "expected_in": ["engineering@example.com"]},
    {"turn": 17, "user": "我不希望回答中出现银行卡、密码等敏感信息。", "expected_in": ["敏感信息"]},
    {"turn": 18, "user": "请记住 Atlas 使用 PostgreSQL 和 Redis。", "expected_in": ["PostgreSQL", "Redis"]},
    {"turn": 19, "user": "现在只讨论旅行，不要提及 Atlas。", "expected_in": ["旅行"], "expected_not_in": ["银行卡号", "密码"]},
