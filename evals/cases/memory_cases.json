    {"turn": 4, "user": "我偏好的数据库是 PostgreSQL。", "expected_in": ["PostgreSQL"]},
    {"turn": 5, "user": "我习惯用 pytest 写测试。", "expected_in": ["pytest"]},
    {"turn": 6, "user": "我通常在 UTC+8 时区工作。", "expected_in": ["UTC+8"]},
    {"turn": 7, "user": "Atlas 的生产环境运行在 Linux。", "expected_in": ["Linux"]},
    {"turn": 8, "user": "请暂时不要保存我的银行卡号。", "expected_in": ["不要保存"]},
